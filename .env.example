# Copy this file to .env and fill in your keys (never commit .env)

# Required. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Recommended for web search on cloud hosts. Free tier (1000 searches/month): https://app.tavily.com
# Without it the agent falls back to free scraping engines, which are often blocked on cloud hosts.
# TAVILY_API_KEY=your_tavily_api_key_here

# Optional: where chats and memory are stored (default: ./chatbot.db)
# CHATBOT_DB_PATH=./chatbot.db
